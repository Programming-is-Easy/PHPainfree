# Copy this file to .env
#
# NEVER check .env into your version control. Protect your secrets!
ENVIRONMENT=development # change to "production" on a real server

# RECOMMENDED MODIFICATION - Must match the credentials and network container 
# name defined in docker-compose.yml
MYSQL_DATABASE=painfree
MYSQL_USER=painfree
MYSQL_PASSWORD=painfree
MYSQL_HOST=phpainfree-mysql
MYSQL_PORT=3306
